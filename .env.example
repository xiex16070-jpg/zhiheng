# ---- 存储与缓存（缺省自动降级为文件存储 / 进程内缓存）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=csl_agent

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

PORT=3000

# ---- Langfuse 元数据追踪，默认关闭。仅配置服务器环境变量，修改后重启 ----
LANGFUSE_TRACING_ENABLED=0
# Langfuse 实例的根地址。远程仅接受 HTTPS，本机可用 http://127.0.0.1:端口
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 向量检索 ----
# 不配 QDRANT_URL 时退化为进程内向量表
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=csl_kb

# ---- 嵌入 ----
# 留空 EMBEDDING_BASE_URL 时用内置哈希嵌入（纯词面相似，离线可用）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH=16
# 同维模型/权重切换也须换 revision 并重建索引，不能仅检查维度。
EMBEDDING_REVISION=
# 本机 BGE 可选配置见 services/embedder/README.md：provider=service，
# baseUrl=http://127.0.0.1:8092，model=BAAI/bge-m3，dim=1024。
# 新窗口索引先用 scripts/index-formal-vectors.mjs --plan 检查，不自动替换在线集合。

# ---- RAGFlow 外部知识源（MCP 优先，REST 兜底）----
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
RAGFLOW_MCP_PATH=/mcp

# ---- 检索融合 ----
RRF_K=60
PAPER_TOP_K=30
CHUNK_TOP_K=30
VECTOR_TOP_K=30
EXTERNAL_TOP_K=10

# ---- 可选 BGE 重排（独立 Python 服务，默认关闭）----
# 安装/启动见 services/reranker/README.md；失败回退原 RRF。
# 0=关闭，1=启用，auto=服务健康检查成功后启用。
RERANK_ENABLED=0
RERANK_URL=http://127.0.0.1:8091/rerank
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=30
RERANK_TIMEOUT_MS=5000
RERANK_MAX_CHARS=6000

# ---- 可选 MinerU PDF 解析（自托管 4.1 Tasks API，默认关闭）----
# 安装、页码映射与许可证说明见 services/mineru/README.md
MINERU_ENABLED=0
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_TIER=standard
MINERU_OCR_MODE=auto
MINERU_TIMEOUT_MS=120000
MINERU_POLL_MS=1000
MINERU_MAX_RESPONSE_BYTES=67108864
MINERU_FALLBACK=1

# ---- 上传限制 ----
# 单个文件上限（字节）。默认 64MB；上传内容会整体读入内存，
# 实测 30MB 文件峰值内存约 120MB、64MB 约 250MB，建议不超过 256MB
UPLOAD_MAX_BYTES=67108864
UPLOAD_MAX_DOCS=200
# 单文档正文上限（字符）。纯文字大文件解出几千万字会拖垮分块与索引
UPLOAD_MAX_TEXT_CHARS=5000000

# ---- 身份与鉴权 ----
# 会话签名密钥；留空则首次启动自动生成并写入 data/.auth-secret
AUTH_SECRET=
# R01：本机回环明文身份兼容层，默认关闭。历史数据迁移时临时设 1，
# 浏览器访问一次页面完成 Cookie 重签后改回 0
LEGACY_LOOPBACK_IDENTITY=0
# R01：部署在反向代理（Nginx/Caddy 等）之后时设 1——带 X-Forwarded-For 的请求不视为本机回环
TRUST_PROXY=0
# 会话签名有效期（天），默认 365
SESSION_TTL_DAYS=365
# Phase A：用户工作区（文件工具沙箱 data/workspace/<userId>/）
WORKSPACE_MAX_FILE_BYTES=2097152
WORKSPACE_MAX_FILES=500
WORKSPACE_READ_CAP_BYTES=65536
# R09：任务内辅助模型调用（查询改写/上下文压缩摘要/推断审核/兜底作答）共享预算上限，默认 2。
# 设 0 = 完全关闭任务内辅助调用（轨迹中如实标注「已跳过（辅助预算）」；查询改写静默降级为原查询）。
# 学习审查发生在任务结束后，不占此预算；每用户可在设置面板关闭（偏好 learning:off）
AUX_LLM_MAX_CALLS=2
# 配置后 HTTP MCP 必须带 Authorization 头（Bearer 令牌）；单令牌绑定 MCP_USER_ID 身份
MCP_TOKEN=
# 官方 SDK 协议适配：默认关闭；开启后 HTTP 走无状态 Streamable HTTP
MCP_SDK_ENABLED=0
# 单令牌绑定的用户身份（默认 mcp）
MCP_USER_ID=mcp
# R02：多令牌 → 身份绑定，格式 "tok1:userA,tok2:userB"（与 MCP_TOKEN 并存，命中即绑定）。
# 配置任一令牌后，回环匿名调用 /mcp 也会被拒绝；未配置任何令牌时仅本机回环放行
MCP_TOKENS=
# R03：学习系统管理操作（技能 pin/归档、他人台账回滚）的管理员令牌。
# 请求头 x-admin-token 常量时间比较；留空则无人是管理员（除非开 ADMIN_LOOPBACK）
ADMIN_TOKEN=
# R03：单机部署便利开关——本机回环请求视为管理员（公网/反代部署必须保持 0）
ADMIN_LOOPBACK=0

# ---- 长期记忆与自学习 ----
# 总开关：关掉后不注入记忆/技能、不触发审查、不跑 curator
LEARNING_ENABLED=true
# 训练数据采集：每个结束的任务把完整轨迹（系统提示、工具定义、工具调用与结果、最终回答、自动检查）
# 脱敏后写到 DATA_DIR/trajectories，仅在本机；用户把「学习」偏好设为关闭时不采集。
# 导出：node scripts/export-trajectories.mjs --format sft|dpo|raw --out <文件>（再次脱敏与质量检查）
TRAJECTORY_CAPTURE=true
# 记忆双库字符预算（§ 连接后总长）
MEMORY_CHAR_LIMIT=4000
USER_CHAR_LIMIT=2000
# 无错误信号时每 N 个任务例行审查一次；有错误信号的任务立即入队
REVIEW_EVERY_TASKS=10
# 审查合并窗口与排队龄期上限（毫秒）
REVIEW_SETTLE_MS=15000
REVIEW_MAX_AGE_MS=1800000
# 技能描述索引预算（与提示词索引展示宽度一致，勿随意调大）
SKILL_DESC_LIMIT=60
# 每任务注入的匹配技能数与单条截断
INJECT_SKILLS=3
INJECT_SKILL_CHARS=1500
# curator 生命周期（天）与运行间隔（小时）
CURATOR_STALE_DAYS=14
CURATOR_ARCHIVE_DAYS=30
CURATOR_INTERVAL_HOURS=24

# ---- 推理循环上下文管理 ----
# 循环 token 软预算（估算值，非模型窗口；超 84% 触发自动压缩）
CONTEXT_TOKEN_BUDGET=60000
CONTEXT_COMPACT_RATIO=0.84
# 压缩后保留的尾部原文条数
CONTEXT_KEEP_TAIL=6
# 微压缩保留的最近工具结果条数与最小节省量（低于则不做）
CONTEXT_MICRO_KEEP_RECENT=4
CONTEXT_MICRO_MIN_SAVINGS=1000

# ---- Phase B：审批制命令执行（默认关；开启后 run_command 进入工具表）----
EXEC_ENABLED=0
EXEC_TIMEOUT_MS=30000
EXEC_MAX_TIMEOUT_MS=120000
EXEC_MAX_OUTPUT_BYTES=32768
EXEC_MAX_PROCS=2
# 只读前缀（免审批），用 | 分隔；留空用内置默认（ls/cat/grep/git status/--version 等）
# EXEC_ALLOW_PREFIXES=ls|cat|grep|git status|node --version

# ---- Phase C3：网页抓取与联网检索 ----
# 本机可从「设置 → 网站搜索」分别保存 Tavily、Serper、OpenAlex，Europe PMC 无需 Key。
# 多个网站引擎可同时启用，无需重启；界面保存的加密配置优先于以下兼容环境配置。
# 备份凭据时一并保留 data/.credential-key；AUTH_SECRET 轮换不影响已迁移的 v2 凭据。
WEB_FETCH_ENABLED=1
# 检索后端：tavily | serper | bing（留空则不注册 web_search 工具）
WEB_SEARCH_PROVIDER=
WEB_SEARCH_KEY=
WEB_EXTRACT_MAX_CHARS=12000
WEB_CACHE_TTL_MS=900000
WEB_FETCH_TIMEOUT_MS=20000
WEB_MAX_BYTES=2097152

# ---- 推理循环 ----
# 单任务工具轮次上限（读多个文件、修改、分段写入与审批恢复常需 10 轮以上）
MAX_TOOL_ROUNDS=20
# 远程模型单次输出上限；达到上限时正文续写、工具调用改为分段，最多恢复 2 次
REMOTE_MAX_TOKENS=4096
# ---- 默认专业全文库（无需数据库，不与旧MySQL papers表混用）----
CORPUS_PROFILE=formal
# 留空使用随仓库提供的 data/formal/papers.jsonl 与 manifest.json
CORPUS_JSONL=
CORPUS_MANIFEST=
# 旧CSL：CORPUS_PROFILE=legacy-csl；自定义：CORPUS_PROFILE=custom + CORPUS_JSONL

# ---- 外部文献检索（Europe PMC / arXiv，keyless 公共 API）----
SCHOLAR_SEARCH=1
# 联合研究同时使用 OpenAlex。推荐在设置中保存免费 Key，匿名请求可能 429。
OPENALEX_API_KEY=
SCHOLAR_MAX_RESULTS=10

# ---- 2026-11 Agent 能力整合 ----
# 2026-11-06：命令/进程/Tectonic/上下文参数可在本机“设置→执行环境”按用户覆盖。
# data/runtime-settings/<uid>.json 不存在时才使用此处默认值；损坏时拒绝覆盖。
# 本机浏览器默认关闭，只在本机设置开启；没有通过模型工具修改此开关的入口。
# 智能体团队在设置中配置并加密保存凭据，不需要新增环境变量。
# 子代理默认可用：仅只读工具、深度 1、全局最多同时 3 个；每任务累计数量/调用受限。
SUBAGENT_MAX_CALLS=8
SUBAGENT_MAX_PER_TASK=5
# 可选命令风险建议；APPROVE 也不代替用户批准，消耗现有 AUX_LLM_MAX_CALLS。
EXEC_GUARD=0
# 持久进程会话须同时开 EXEC_ENABLED；启动和每次输入各自审批，默认不启用。
EXEC_SESSIONS=0
# 跟进问题默认规则生成；llm 模式使用现有辅助模型预算。
SUGGEST_MODE=rules
# PDF 编辑默认可用；设 0 隐藏 pdf_inspect/fill/split/merge，create_document 不受影响。
PDF_TOOLS=1
# 仅可信 Tectonic 绝对路径；不自动安装，不联网拉包，不接受 xelatex 的任意执行。
# 编译还需本用户命令执行开启（设置或 EXEC_ENABLED 默认值）与当前参数审批；仅数学排版安全子集。
LATEX_ENGINE_PATH=
# 学术源独立失败时其余源可继续，429 会提示限流；不得把摘要当作已核验全文。
SCHOLAR_SOURCES=europepmc,arxiv,openalex,crossref,semanticscholar
SEMANTIC_SCHOLAR_API_KEY=
# Zotero 在每用户设置中显式启用与保存本地 API 授权，不使用全局环境变量授权。
# 视觉能力在模型连接中勾选 vision；生成图片使用单独的 image 连接并逐次审批。
# 外部计划任务专用凭据：每个令牌 >=24 字符，形如 token:userId，逗号分隔。
# 只准 POST /api/chat，不能审批、修改设置或读取其他接口；留空关闭。
SERVICE_TOKENS=
